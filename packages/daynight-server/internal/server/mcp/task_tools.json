  {
    "name": "task_update",
    "description": "Atomically change fields and dependency classification. Omission preserves; null clears nullable fields.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "projectId": {
          "type": "string",
          "format": "uuid"
        },
        "taskId": {
          "type": "string",
          "format": "uuid"
        },
        "ifVersion": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,18}$",
          "description": "Exact positive int64 decimal; omit only where current CLI reads a version before writing."
        },
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "assignedTo": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "requiredPlatform": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "windows",
                "linux",
                "macos"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "allowAgents": {
          "type": "boolean"
        },
        "dependsOn": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uuid"
          },
          "uniqueItems": true,
          "description": "Ordinary prerequisites only; disjoint from externalDependsOn. Supplying either replaces both classifications."
        },
        "externalDependsOn": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uuid"
          },
          "uniqueItems": true,
          "description": "External prerequisites only; disjoint from dependsOn. Supplying either replaces both classifications."
        },
        "returnView": {
          "enum": [
            "summary",
            "full"
          ],
          "default": "summary"
        }
      },
      "required": [
        "projectId",
        "taskId"
      ],
      "additionalProperties": false,
      "anyOf": [
        {
          "required": [
            "title"
          ]
        },
        {
          "required": [
            "description"
          ]
        },
        {
          "required": [
            "assignedTo"
          ]
        },
        {
          "required": [
            "requiredPlatform"
          ]
        },
        {
          "required": [
            "allowAgents"
          ]
        },
        {
          "required": [
            "dependsOn"
          ]
        },
        {
          "required": [
            "externalDependsOn"
          ]
        }
      ]
    },
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": true,
      "openWorldHint": false
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "data": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "format": "uuid"
            },
            "version": {
              "type": "string",
              "pattern": "^[1-9][0-9]{0,18}$"
            }
          }
        },
        "meta": {
          "type": "object",
          "properties": {
            "requestId": {
              "type": "string"
            },
            "outcome": {
              "type": "string"
            }
          },
          "required": [
            "requestId"
          ]
        },
        "error": {
          "type": "object",
          "properties": {
            "code": {
              "type": "string"
            },
            "message": {
              "type": "string"
            },
            "requestId": {
              "type": "string"
            },
            "writeOutcome": {
              "enum": [
                "confirmed",
                "not_committed",
                "unknown"
              ]
            },
            "phase": {
              "type": "string"
