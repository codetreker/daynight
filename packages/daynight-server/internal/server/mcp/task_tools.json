  {
    "name": "task_set_status",
    "description": "Set Task status; cancelled is irreversible and satisfies dependencies. Explicit claimId is valid only for completing an owned active claim.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "projectId": {
          "type": "string",
          "format": "uuid"
        },
        "taskId": {
          "type": "string",
          "format": "uuid"
        },
        "status": {
          "type": "string",
          "enum": [
            "todo",
            "in_progress",
            "done",
            "cancelled"
          ]
        },
        "claimId": {
          "type": "string",
          "format": "uuid"
        },
        "ifVersion": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,18}$",
          "description": "Exact positive int64 decimal; omit only where current CLI reads a version before writing."
        },
        "returnView": {
          "enum": [
            "summary",
            "full"
          ],
          "default": "summary"
        }
      },
      "required": [
        "projectId",
        "taskId",
        "status"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "required": [
              "claimId"
            ]
          },
          "then": {
            "properties": {
              "status": {
                "const": "done"
              }
            }
          }
        }
      ]
    },
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": true,
      "openWorldHint": false
    },
