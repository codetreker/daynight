[
  {
    "name": "task_create",
    "description": "Create a Task or Goal. Task defaults to proposed and Goal to todo; omitted assignee is the current account. Goal permits an explicit null assignee and has no execution platform or ordinary Task dependencies; it starts without acceptance relationships, which can be edited separately. Supply tagIds as the complete Project tag UUID set.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "projectId": {
          "type": "string",
          "format": "uuid"
        },
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string",
          "description": "Brief Task or Goal overview of the work, expected outcome and necessary scope, with material references. Put detailed material in attachments. A simple task fully explained in a few sentences needs no attachment."
        },
        "assignedTo": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        },
        "requiredPlatform": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "windows",
            "linux",
            "macos",
            null
          ]
        },
        "dependsOn": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uuid"
          },
          "uniqueItems": true,
          "description": "Ordinary prerequisites only; disjoint from externalDependsOn. Supplying either replaces both classifications."
        },
        "externalDependsOn": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uuid"
          },
          "uniqueItems": true,
          "description": "External prerequisites only; disjoint from dependsOn. Supplying either replaces both classifications."
        },
        "returnView": {
          "enum": [
            "summary",
            "full",
            "receipt"
          ],
          "description": "Receipt returns only Task identity and version. If omitted, credentials without task:read receive a receipt; other callers receive a summary."
        },
        "status": {
          "type": "string",
          "enum": [
            "proposed",
            "todo",
            "in_progress",
            "done",
            "cancelled"
          ]
        },
        "type": {
          "type": "string",
          "enum": [
            "task",
            "goal"
          ],
          "default": "task"
        },
        "parentId": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        },
        "tagIds": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uuid"
          },
          "description": "Complete Project tag UUID set; omit to preserve on update, or supply an empty array to clear."
        },
        "taskParentView": {
          "type": "string",
          "enum": [
            "v1"
          ],
          "description": "Select the ordinary Task parent projection. Omit to keep the default Goal-only parentId fields."
        }
      },
      "required": [
        "projectId",
        "title"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "const": "goal"
              }
            }
          },
          "then": {
            "properties": {
              "status": {
                "enum": [
                  "todo",
                  "in_progress",
                  "done",
                  "cancelled"
                ]
              },
              "parentId": {
                "type": "null"
              },
              "dependsOn": {
                "maxItems": 0
              },
              "externalDependsOn": {
                "maxItems": 0
              }
            },
            "not": {
              "required": [
                "requiredPlatform"
              ]
            }
          },
          "else": {
            "properties": {
              "status": {
                "enum": [
                  "proposed",
                  "todo"
                ]
              },
              "assignedTo": {
                "type": "string",
                "format": "uuid"
              },
              "requiredPlatform": {
                "type": "string",
                "enum": [
                  "windows",
                  "linux",
                  "macos"
                ]
              }
            }
          }
        }
      ]
    },
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": false,
      "openWorldHint": false
    }
  },
  {
    "name": "task_show",
    "description": "Read the complete Task resource. Summary is default; full content is explicit and may be large. Includes ephemeral Session observation, freshness and send eligibility; partial observations retain Task data.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "projectId": {
          "type": "string",
          "format": "uuid"
        },
        "taskId": {
          "type": "string",
          "format": "uuid"
        },
        "view": {
          "enum": [
            "summary",
            "full"
          ],
          "default": "summary"
        },
        "taskParentView": {
          "type": "string",
          "enum": [
            "v1"
          ],
          "description": "Select the ordinary Task parent projection. Omit to keep the default Goal-only parentId fields."
        }
      },
      "required": [
        "projectId",
        "taskId"
      ],
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "openWorldHint": false
    }
  },
  {
    "name": "task_update",
    "description": "Atomically change fields and dependency classification. Omission preserves; null clears nullable fields. Supply tagIds as the complete Project tag UUID set.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "projectId": {
          "type": "string",
          "format": "uuid"
        },
        "taskId": {
          "type": "string",
          "format": "uuid"
        },
        "ifVersion": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,18}$",
          "description": "Exact positive int64 decimal; omit only where current CLI reads a version before writing."
        },
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string",
          "description": "Brief Task or Goal overview of the work, expected outcome and necessary scope, with material references. Put detailed material in attachments. A simple task fully explained in a few sentences needs no attachment."
        },
        "assignedTo": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "requiredPlatform": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "windows",
                "linux",
                "macos"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "allowAgents": {
          "type": "boolean"
        },
        "dependsOn": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uuid"
          },
          "uniqueItems": true,
          "description": "Ordinary prerequisites only; disjoint from externalDependsOn. Supplying either replaces both classifications."
        },
        "externalDependsOn": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uuid"
          },
          "uniqueItems": true,
          "description": "External prerequisites only; disjoint from dependsOn. Supplying either replaces both classifications."
        },
        "returnView": {
          "enum": [
            "summary",
            "full",
            "receipt"
          ],
          "description": "Receipt returns only Task identity and version. If omitted, credentials without task:read receive a receipt; other callers receive a summary."
        },
        "parentId": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid",
          "description": "Omit to retain, null to clear, or a Goal UUID to assign."
        },
        "tagIds": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uuid"
          },
          "description": "Complete Project tag UUID set; omit to preserve on update, or supply an empty array to clear."
        },
        "taskParentView": {
          "type": "string",
          "enum": [
            "v1"
          ],
          "description": "Select the ordinary Task parent projection. Omit to keep the default Goal-only parentId fields."
        }
      },
      "required": [
        "projectId",
        "taskId"
      ],
      "additionalProperties": false,
      "anyOf": [
        {
          "required": [
            "title"
          ]
        },
        {
          "required": [
            "description"
          ]
        },
        {
          "required": [
            "assignedTo"
          ]
        },
        {
          "required": [
            "requiredPlatform"
          ]
        },
        {
          "required": [
            "allowAgents"
          ]
        },
        {
          "required": [
            "dependsOn"
          ]
        },
        {
          "required": [
            "externalDependsOn"
          ]
        },
        {
          "required": [
            "parentId"
          ]
        },
        {
          "required": [
            "tagIds"
          ]
        }
      ]
    },
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": true,
      "openWorldHint": false
    }
  },
  {
    "name": "task_set_status",
    "description": "Set Task status. For ordinary Tasks, cancelled is irreversible and satisfies dependencies. Explicit claimId is valid only for completing an owned active claim.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "projectId": {
          "type": "string",
          "format": "uuid"
        },
        "taskId": {
          "type": "string",
          "format": "uuid"
        },
        "status": {
          "type": "string",
          "enum": [
            "proposed",
            "todo",
            "in_progress",
            "done",
            "cancelled"
          ]
        },
        "claimId": {
          "type": "string",
          "format": "uuid"
        },
        "ifVersion": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,18}$",
          "description": "Exact positive int64 decimal; omit only where current CLI reads a version before writing."
        },
        "returnView": {
          "enum": [
            "summary",
            "full",
            "receipt"
          ],
          "description": "Receipt returns only Task identity and version. If omitted, credentials without task:read receive a receipt; other callers receive a summary."
        },
        "taskParentView": {
          "type": "string",
          "enum": [
            "v1"
          ],
          "description": "Select the ordinary Task parent projection. Omit to keep the default Goal-only parentId fields."
        }
      },
      "required": [
        "projectId",
        "taskId",
        "status"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "required": [
              "claimId"
            ]
          },
          "then": {
            "properties": {
              "status": {
                "const": "done"
              }
            }
          }
        }
      ]
    },
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": true,
      "openWorldHint": false
    }
  },
  {
    "name": "task_delete",
    "description": "Soft-delete a Task. Existing stored data and attachments are retained. Deleting a Goal hides it and all its children without removing their parent links; active executions stop later through existing cleanup.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "projectId": {
          "type": "string",
          "format": "uuid"
        },
        "taskId": {
          "type": "string",
          "format": "uuid"
        },
        "removeDepends": {
          "type": "boolean"
        },
        "ifVersion": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,18}$",
          "description": "Exact positive int64 decimal; omit only where current CLI reads a version before writing."
        }
      },
      "required": [
        "projectId",
        "taskId"
      ],
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": true,
      "openWorldHint": false
    }
  },
  {
    "name": "task_properties",
    "description": "Read server property schemas or current Task property values.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "mode": {
          "enum": [
            "schema",
            "values"
          ]
        },
        "projectId": {
          "type": "string",
          "format": "uuid"
        },
        "taskId": {
          "type": "string",
          "format": "uuid"
        }
      },
      "required": [
        "mode"
      ],
      "additionalProperties": false,
      "oneOf": [
        {
          "properties": {
            "mode": {
              "const": "schema"
            }
          },
          "not": {
            "anyOf": [
              {
                "required": [
                  "projectId"
                ]
              },
              {
                "required": [
                  "taskId"
                ]
              }
            ]
          }
        },
        {
          "properties": {
            "mode": {
              "const": "values"
            }
          },
          "required": [
            "projectId",
            "taskId"
          ]
        }
      ]
    },
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "openWorldHint": false
    }
  },
