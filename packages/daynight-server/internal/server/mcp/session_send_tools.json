        },
        "executionGeneration": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,18}$"
        },
        "expectedTurnId": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 256
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1048576
        }
      },
      "required": [
        "projectId",
        "taskId",
        "sessionId",
        "operationId",
        "claimId",
        "executionGeneration",
        "expectedTurnId",
        "text"
      ],
      "additionalProperties": false
    },
    "annotations": {
