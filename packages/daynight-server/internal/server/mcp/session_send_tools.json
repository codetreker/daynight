[
  {
    "name": "task_session_send",
    "description": "Send one exact ordinary text message to the supplied Task execution. Supply an owned operationId and frozen command fence; expectedTurnId must be null for idle. connectionEpoch is not a command fence. Text is limited to 1 MiB UTF-8 and the encoded command to 2 MiB. Slash text stays text. After any unknown result, query the original operation ID without resending.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "projectId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "taskId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "sessionId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "operationId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "claimId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "executionGeneration": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,18}$"
        },
        "expectedTurnId": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 256
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1048576
        }
      },
      "required": [
        "projectId",
        "taskId",
        "sessionId",
        "operationId",
        "claimId",
        "executionGeneration",
        "expectedTurnId",
        "text"
      ],
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false
    }
  },
  {
    "name": "task_session_operation",
    "description": "Read the original persisted Task Session receipt, including after a claim change. currentBinding describes the current Task relation. not_found leaves the send outcome unknown; never infer that it is safe to resend.",
