[
  {
    "name": "task_list",
    "description": "Read a page ordered in-progress, ready todo, blocked todo, then done or cancelled; default excludes both terminal statuses. Summary is default; request full list resources explicitly.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "projectId": {
          "type": "string",
          "format": "uuid"
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "default": 50
        },
        "cursor": {
          "type": "string"
        },
        "all": {
          "type": "boolean"
        },
        "status": {
          "type": "string",
          "enum": [
            "todo",
            "in_progress",
            "done",
            "cancelled"
          ]
        },
        "assignedTo": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid"
            },
            {
              "enum": [
                "me",
                "unassigned"
              ]
            }
          ]
        },
        "ready": {
          "type": "boolean"
        },
        "allowAgents": {
          "type": "boolean"
        },
        "compatiblePlatform": {
          "type": "string",
          "enum": [
            "windows",
            "linux",
            "macos"
          ]
        },
        "view": {
          "enum": [
            "summary",
            "full"
          ],
          "default": "summary"
        }
      },
      "required": [
        "projectId"
      ],
      "additionalProperties": false,
      "not": {
        "required": [
          "all",
          "status"
        ],
        "properties": {
          "all": {
            "const": true
          }
        }
      }
    },
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "openWorldHint": false
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "data": {
          "type": "object",
          "properties": {
            "items": {
              "type": "array",
              "items": {
                "type": "object"
              }
            },
            "nextCursor": {
              "type": [
                "string",
                "null"
              ]
            },
            "projection": {
              "enum": [
                "summary",
                "full"
              ]
            }
          },
          "required": [
            "items"
          ]
        },
        "meta": {
          "type": "object",
          "properties": {
            "requestId": {
              "type": "string"
            },
            "outcome": {
              "type": "string"
            }
          },
          "required": [
            "requestId"
          ]
        },
        "error": {
          "type": "object",
          "properties": {
            "code": {
              "type": "string"
            },
            "message": {
              "type": "string"
            },
            "requestId": {
              "type": "string"
            },
            "writeOutcome": {
              "enum": [
                "confirmed",
                "not_committed",
                "unknown"
              ]
            },
            "phase": {
              "type": "string"
            },
            "refs": {
              "type": "object"
            }
          },
          "required": [
            "code",
            "message",
            "requestId"
          ]
        }
      },
      "oneOf": [
        {
          "required": [
            "data",
            "meta"
          ],
          "not": {
            "required": [
              "error"
            ]
          }
        },
        {
          "required": [
            "error"
          ],
          "not": {
            "required": [
              "data"
            ]
          }
        }
      ]
    }
  },
