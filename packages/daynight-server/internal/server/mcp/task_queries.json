[
  {
    "name": "task_list",
    "description": "Read a page ordered in-progress, ready todo, blocked todo, then proposed and terminal tasks; default excludes both terminal statuses. Summary is default; request full list resources explicitly. Includes ephemeral Session observation, freshness and send eligibility; partial observations retain Task data.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "projectId": {
          "type": "string",
          "format": "uuid"
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "default": 50
        },
        "cursor": {
          "type": "string"
        },
        "all": {
          "type": "boolean"
        },
        "status": {
          "type": "string",
          "enum": [
            "proposed",
            "todo",
            "in_progress",
            "done",
            "cancelled"
          ]
        },
        "assignedTo": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid"
            },
            {
              "enum": [
                "me",
                "unassigned"
              ]
            }
          ]
        },
        "ready": {
          "type": "boolean"
        },
        "allowAgents": {
          "type": "boolean"
        },
        "compatiblePlatform": {
          "type": "string",
          "enum": [
            "windows",
            "linux",
            "macos"
          ]
        },
        "view": {
          "enum": [
            "summary",
            "full"
          ],
          "default": "summary"
        },
        "type": {
          "type": "string",
          "enum": [
            "task",
            "goal"
          ],
          "default": "task",
          "description": "Select ordinary tasks (default) or Goals."
        },
        "parentId": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid",
          "description": "Omit for all parents; null selects unparented tasks; a Goal UUID selects its direct children."
        },
        "tagIds": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uuid"
          },
          "description": "Project tag UUIDs; applied with other filters before pagination or the ready limit. Empty means no tag condition unless untagged is true."
        },
        "tagMatch": {
          "type": "string",
          "enum": [
            "all",
            "any"
          ],
          "default": "all",
          "description": "Match all selected tags or any selected tag; defaults to all."
        },
        "untagged": {
          "type": "boolean",
          "description": "Select resources without tags; conflicts with a nonempty tagIds set."
        },
        "taskParentView": {
          "type": "string",
          "enum": [
            "v1"
          ],
          "description": "Select the ordinary Task parent projection. Omit to keep the default Goal-only parentId fields."
        },
        "parentTaskId": {
          "type": "string",
          "format": "uuid",
          "description": "Select direct children of this visible ordinary Task in the same Project; conflicts with parentId."
        }
      },
      "required": [
        "projectId"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "not": {
            "required": [
              "all",
              "status"
            ],
            "properties": {
              "all": {
                "const": true
              }
            }
          }
        },
        {
          "not": {
            "required": [
              "parentId",
              "parentTaskId"
            ]
          }
        }
      ]
    },
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "openWorldHint": false
    }
  },
  {
    "name": "task_ready",
    "description": "Read at most limit ready Tasks ordered by creation time and UUID; default 5, maximum 20, without pagination. Summary is default; full includes complete Task descriptions.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "projectId": {
          "type": "string",
          "format": "uuid"
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20,
          "default": 5
        },
        "allowAgents": {
          "type": "boolean"
        },
        "compatiblePlatform": {
          "type": "string",
          "enum": [
            "windows",
            "linux",
            "macos"
          ]
        },
        "view": {
          "enum": [
            "summary",
            "full"
          ],
          "default": "summary"
        },
        "parentId": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid",
          "description": "Omit for all parents; null selects unparented tasks; a Goal UUID selects its direct children."
        },
        "tagIds": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uuid"
          },
          "description": "Project tag UUIDs; applied with other filters before pagination or the ready limit. Empty means no tag condition unless untagged is true."
        },
        "tagMatch": {
          "type": "string",
          "enum": [
            "all",
            "any"
          ],
          "default": "all",
          "description": "Match all selected tags or any selected tag; defaults to all."
        },
        "untagged": {
          "type": "boolean",
          "description": "Select resources without tags; conflicts with a nonempty tagIds set."
        },
        "taskParentView": {
          "type": "string",
          "enum": [
            "v1"
          ],
          "description": "Select the ordinary Task parent projection. Omit to keep the default Goal-only parentId fields."
        },
        "parentTaskId": {
          "type": "string",
          "format": "uuid",
          "description": "Select direct children of this visible ordinary Task in the same Project; conflicts with parentId."
        }
      },
      "required": [
        "projectId"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "not": {
            "required": [
              "parentId",
              "parentTaskId"
            ]
          }
        }
      ]
    },
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "openWorldHint": false
    }
  },
  {
    "name": "task_graph",
    "description": "Read the complete dependency graph or its dependency-only projection. Includes Session observations and the ordinary-member summary unless dependsOnly is true; external nodes do not contribute.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "projectId": {
          "type": "string",
          "format": "uuid"
        },
        "taskId": {
          "type": "string",
          "format": "uuid"
        },
        "dependsOnly": {
          "type": "boolean"
        },
        "view": {
          "enum": [
            "summary",
            "full"
          ],
          "default": "summary"
        },
        "taskParentView": {
          "type": "string",
          "enum": [
            "v1"
          ],
          "description": "Select the ordinary Task parent projection. Omit to keep the default Goal-only parentId fields."
        }
      },
      "required": [
        "projectId",
        "taskId"
      ],
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "openWorldHint": false
    }
  }
]
