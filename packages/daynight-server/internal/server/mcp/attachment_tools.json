[
  {
    "name": "task_attachment_list",
    "description": "Read one page of attachment paths and metadata.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "projectId": {
          "type": "string",
          "format": "uuid"
        },
        "taskId": {
          "type": "string",
          "format": "uuid"
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "default": 50
        },
        "cursor": {
          "type": "string"
        }
      },
      "required": [
        "projectId",
        "taskId"
      ],
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "openWorldHint": false
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "data": {
          "type": "object",
          "properties": {
            "items": {
              "type": "array",
              "items": {
                "type": "object"
              }
            },
            "nextCursor": {
              "type": [
                "string",
                "null"
              ]
            },
            "projection": {
              "enum": [
                "summary",
                "full"
              ]
            }
          },
          "required": [
            "items"
          ]
        },
        "meta": {
          "type": "object",
          "properties": {
            "requestId": {
              "type": "string"
            },
            "outcome": {
              "type": "string"
            }
          },
          "required": [
            "requestId"
          ]
        },
        "error": {
          "type": "object",
          "properties": {
            "code": {
              "type": "string"
            },
            "message": {
              "type": "string"
            },
            "requestId": {
              "type": "string"
            },
            "writeOutcome": {
              "enum": [
                "confirmed",
                "not_committed",
                "unknown"
              ]
            },
            "phase": {
              "type": "string"
            },
            "refs": {
              "type": "object"
            }
          },
          "required": [
            "code",
            "message",
            "requestId"
          ]
        }
      },
      "oneOf": [
        {
          "required": [
            "data",
            "meta"
          ],
          "not": {
            "required": [
              "error"
            ]
          }
        },
        {
          "required": [
            "error"
          ],
          "not": {
            "required": [
              "data"
            ]
          }
        }
      ]
    }
  },
  {
    "name": "task_attachment_remove",
    "description": "Remove one exact attachment path. Failure may follow file side effects; never infer rollback.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "projectId": {
          "type": "string",
          "format": "uuid"
        },
        "taskId": {
          "type": "string",
          "format": "uuid"
        },
        "path": {
          "type": "string"
        }
      },
      "required": [
        "projectId",
        "taskId",
        "path"
      ],
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": true,
      "openWorldHint": false
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "data": {
          "type": "object"
        },
        "meta": {
          "type": "object",
          "properties": {
            "requestId": {
              "type": "string"
            },
            "outcome": {
              "type": "string"
            }
          },
          "required": [
            "requestId"
          ]
        },
        "error": {
          "type": "object",
          "properties": {
            "code": {
              "type": "string"
            },
            "message": {
              "type": "string"
            },
            "requestId": {
              "type": "string"
            },
            "writeOutcome": {
              "enum": [
                "confirmed",
                "not_committed",
                "unknown"
              ]
            },
            "phase": {
              "type": "string"
            },
            "refs": {
              "type": "object"
            }
          },
          "required": [
            "code",
            "message",
            "requestId"
          ]
        }
      },
      "oneOf": [
        {
          "required": [
            "data",
            "meta"
          ],
          "not": {
            "required": [
              "error"
            ]
          }
        },
        {
          "required": [
            "error"
          ],
          "not": {
            "required": [
              "data"
            ]
          }
        }
      ]
    }
  }
]
