[
  {
    "name": "task_thread_read",
    "description": "Read a bounded page of complete messages oldest first; no boundary selects the latest page.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "projectId": {
          "type": "string",
          "format": "uuid"
        },
        "taskId": {
          "type": "string",
          "format": "uuid"
        },
        "beforeId": {
          "type": "string",
          "format": "uuid"
        },
        "afterId": {
          "type": "string",
          "format": "uuid"
        },
        "count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "default": 20
        },
        "details": {
          "type": "boolean"
        }
      },
      "required": [
        "projectId",
        "taskId"
      ],
      "additionalProperties": false,
      "not": {
        "required": [
          "beforeId",
          "afterId"
        ]
      }
    },
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "openWorldHint": false
    }
  },
  {
    "name": "task_thread_post",
    "description": "Append one immutable message or same-Task reply. Never automatically repeat an unknown submission.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "projectId": {
          "type": "string",
          "format": "uuid"
        },
        "taskId": {
          "type": "string",
          "format": "uuid"
        },
        "body": {
          "type": "string"
        },
        "replyTo": {
          "type": "string",
          "format": "uuid"
        },
        "claimId": {
          "type": "string",
          "format": "uuid"
        }
      },
      "required": [
        "projectId",
        "taskId",
        "body"
      ],
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": false,
      "openWorldHint": false
    }
  }
]
