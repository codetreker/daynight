              ]
            },
            "projection": {
              "enum": [
                "summary",
                "full"
              ]
            }
          },
          "required": [
            "items"
          ]
        },
        "meta": {
          "type": "object",
          "properties": {
            "requestId": {
              "type": "string"
            },
            "outcome": {
              "type": "string"
            }
          },
          "required": [
            "requestId"
          ]
        },
        "error": {
          "type": "object",
          "properties": {
            "code": {
              "type": "string"
            },
            "message": {
              "type": "string"
            },
            "requestId": {
              "type": "string"
            },
            "writeOutcome": {
              "enum": [
                "confirmed",
                "not_committed",
                "unknown"
              ]
            },
            "phase": {
              "type": "string"
            },
            "refs": {
              "type": "object"
            }
          },
          "required": [
            "code",
            "message",
            "requestId"
          ]
        }
      },
      "oneOf": [
        {
          "required": [
            "data",
            "meta"
          ],
          "not": {
            "required": [
              "error"
            ]
          }
        },
        {
          "required": [
            "error"
          ],
          "not": {
            "required": [
              "data"
            ]
          }
        }
      ]
    }
  },
