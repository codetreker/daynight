[
  {
    "name": "project_create",
    "description": "Create a project or return the unique accessible match for its repository.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "Nonempty Unicode text without NUL; at most 256 code points and 1024 UTF-8 bytes."
        },
        "repoUrl": {
          "type": "string",
          "description": "Repository address, at most 4096 UTF-8 bytes."
        },
        "team": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid"
            },
            {
              "const": "personal"
            }
          ]
        },
        "confirm": {
          "const": true
        }
      },
      "required": [
        "name",
        "repoUrl",
        "team"
      ],
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": false,
      "openWorldHint": false
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "data": {
          "type": "object"
        },
        "meta": {
          "type": "object",
          "properties": {
            "requestId": {
              "type": "string"
            },
            "outcome": {
              "type": "string"
            }
          },
          "required": [
            "requestId"
          ]
        },
        "error": {
          "type": "object",
          "properties": {
            "code": {
              "type": "string"
            },
            "message": {
              "type": "string"
            },
            "requestId": {
              "type": "string"
            },
            "writeOutcome": {
              "enum": [
                "confirmed",
                "not_committed",
                "unknown"
              ]
            },
            "phase": {
              "type": "string"
            },
            "refs": {
              "type": "object"
            }
          },
          "required": [
            "code",
            "message",
            "requestId"
          ]
        }
      },
      "oneOf": [
        {
          "required": [
            "data",
            "meta"
          ],
          "not": {
            "required": [
              "error"
            ]
          }
        },
        {
          "required": [
            "error"
          ],
          "not": {
            "required": [
              "data"
            ]
          }
        }
      ]
    }
  },
  {
    "name": "project_transfer",
    "description": "Transfer project ownership with the observed ownership version.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "projectId": {
          "type": "string",
          "format": "uuid"
        },
        "toTeam": {
          "type": "string",
          "description": "Canonical Team UUID or exact same-service /teams/{uuid} link."
        },
        "ifVersion": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,18}$",
          "description": "Exact positive int64 decimal; omit only where current CLI reads a version before writing."
        },
        "confirm": {
          "const": true
        }
      },
      "required": [
        "projectId",
        "toTeam",
        "confirm"
      ],
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": true,
      "openWorldHint": false
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "data": {
          "type": "object"
        },
        "meta": {
          "type": "object",
          "properties": {
            "requestId": {
              "type": "string"
            },
            "outcome": {
              "type": "string"
            }
          },
          "required": [
            "requestId"
          ]
        },
        "error": {
          "type": "object",
          "properties": {
            "code": {
              "type": "string"
            },
            "message": {
              "type": "string"
            },
            "requestId": {
              "type": "string"
            },
            "writeOutcome": {
              "enum": [
                "confirmed",
                "not_committed",
                "unknown"
              ]
            },
            "phase": {
              "type": "string"
            },
            "refs": {
              "type": "object"
            }
          },
          "required": [
            "code",
            "message",
            "requestId"
          ]
        }
      },
      "oneOf": [
        {
          "required": [
            "data",
            "meta"
          ],
          "not": {
            "required": [
              "error"
            ]
          }
        },
        {
          "required": [
            "error"
          ],
          "not": {
            "required": [
              "data"
            ]
          }
        }
      ]
    }
  },
