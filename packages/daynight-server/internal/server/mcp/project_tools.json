[
  {
    "name": "project_create",
    "description": "Return the unique accessible repository match in the selected Team, or create with confirmation. Concurrent conflicts return project_repository_conflict.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "Nonempty Unicode text without NUL; at most 256 code points and 1024 UTF-8 bytes."
        },
        "repoUrl": {
          "type": "string",
          "description": "Repository address, at most 4096 UTF-8 bytes."
        },
        "team": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid"
            },
            {
              "const": "personal"
            }
          ]
        },
        "confirm": {
          "const": true
        }
      },
      "required": [
        "name",
        "repoUrl",
        "team"
      ],
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": false,
      "openWorldHint": false
    }
  },
  {
    "name": "project_transfer",
    "description": "Transfer project ownership with the observed ownership version.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "projectId": {
          "type": "string",
          "format": "uuid"
        },
        "toTeam": {
          "type": "string",
          "description": "Canonical Team UUID or exact same-service /teams/{uuid} link."
        },
        "ifVersion": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,18}$",
          "description": "Exact positive int64 decimal; omit only where current CLI reads a version before writing."
        },
        "confirm": {
          "const": true
        }
      },
      "required": [
        "projectId",
        "toTeam",
        "confirm"
      ],
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": true,
      "openWorldHint": false
    }
  },
  {
    "name": "project_list",
    "description": "Read one complete page of accessible projects.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "default": 50
        },
        "cursor": {
          "type": "string"
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "openWorldHint": false
    }
  },
  {
    "name": "project_resolve",
    "description": "Resolve a repository address to the unique accessible Project; no match is not_found and multiple matches are resource_conflict. Read-only.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "repoUrl": {
          "type": "string",
          "description": "HTTPS, SSH URL or SCP repository address, at most 4096 UTF-8 bytes."
        }
      },
      "required": [
        "repoUrl"
      ],
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "openWorldHint": false
    }
  },
  {
    "name": "project_show",
    "description": "Read a project including settings and ownership versions.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "projectId": {
          "type": "string",
          "format": "uuid"
        }
      },
      "required": [
        "projectId"
      ],
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "openWorldHint": false
    }
  }
]
