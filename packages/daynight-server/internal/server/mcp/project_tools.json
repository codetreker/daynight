  {
    "name": "project_resolve",
    "description": "Resolve a repository address to the unique accessible Project; no match is not_found and multiple matches are resource_conflict. Read-only.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "repoUrl": {
          "type": "string",
          "description": "HTTPS, SSH URL or SCP repository address, at most 4096 UTF-8 bytes."
        }
      },
      "required": [
        "repoUrl"
      ],
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "openWorldHint": false
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "data": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "format": "uuid"
            },
            "name": {
              "type": "string"
            },
            "repoUrl": {
              "type": "string"
            },
            "createdAt": {
              "type": "string",
              "format": "date-time"
            },
            "updatedAt": {
              "type": "string",
              "format": "date-time"
            },
            "settings": {
              "type": "object",
              "properties": {
                "version": {
                  "type": "string",
                  "pattern": "^[1-9][0-9]{0,18}$"
                },
                "executionWarningMinutes": {
                  "type": "integer"
                }
              },
              "required": [
                "version",
                "executionWarningMinutes"
              ]
            },
            "ownership": {
              "type": "object",
              "properties": {
                "teamId": {
                  "type": "string",
                  "format": "uuid"
                },
                "version": {
                  "type": "string",
                  "pattern": "^[1-9][0-9]{0,18}$"
                },
                "updatedAt": {
                  "type": "string",
                  "format": "date-time"
                }
              },
              "required": [
                "teamId",
                "version",
                "updatedAt"
              ]
            }
          },
          "required": [
            "id",
            "name",
            "repoUrl",
            "createdAt",
            "updatedAt",
            "settings",
            "ownership"
          ]
        },
        "meta": {
          "type": "object",
          "properties": {
            "requestId": {
              "type": "string"
            },
            "outcome": {
              "type": "string"
            }
          },
          "required": [
            "requestId"
          ]
        },
        "error": {
          "type": "object",
          "properties": {
            "code": {
              "type": "string"
            },
            "message": {
              "type": "string"
            },
            "requestId": {
              "type": "string"
            },
            "writeOutcome": {
              "enum": [
                "confirmed",
                "not_committed",
                "unknown"
              ]
            },
            "phase": {
              "type": "string"
            },
            "refs": {
              "type": "object"
            }
          },
          "required": [
            "code",
            "message",
            "requestId"
          ]
        }
      },
      "oneOf": [
        {
          "required": [
            "data",
            "meta"
          ],
          "not": {
            "required": [
              "error"
            ]
          }
        },
        {
          "required": [
            "error"
          ],
          "not": {
