[
  {
    "name": "task_step_list",
    "description": "Read ordered Steps summaries or full content at one exact parent version; continue with a version-bound cursor.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "projectId": {
          "type": "string",
          "format": "uuid"
        },
        "taskId": {
          "type": "string",
          "format": "uuid"
        },
        "view": {
          "enum": [
            "summary",
            "full"
          ],
          "default": "summary"
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "default": 50
        },
        "cursor": {
          "type": "string"
        }
      },
      "required": [
        "projectId",
        "taskId"
      ],
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "openWorldHint": false
    }
  },
  {
    "name": "task_step_show",
    "description": "Read one full eight-hex Step ID and the exact shared parent version. Summary is default; full content is explicit and may be large.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "projectId": {
          "type": "string",
          "format": "uuid"
        },
        "taskId": {
          "type": "string",
          "format": "uuid"
        },
        "stepId": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{8}$"
        },
        "view": {
          "enum": [
            "summary",
            "full"
          ],
          "default": "summary"
        }
      },
      "required": [
        "projectId",
        "taskId",
        "stepId"
      ],
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "openWorldHint": false
    }
  }
]
