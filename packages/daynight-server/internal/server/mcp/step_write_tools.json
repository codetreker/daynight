[
  {
    "name": "task_step_add",
    "description": "Add one Step with an optional stable eight-hex ID and relative placement.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "projectId": {
          "type": "string",
          "format": "uuid"
        },
        "taskId": {
          "type": "string",
          "format": "uuid"
        },
        "title": {
          "type": "string"
        },
        "id": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{8}$"
        },
        "description": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": [
            "todo",
            "in_progress",
            "done",
            "skipped"
          ]
        },
        "before": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{8}$"
        },
        "after": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{8}$"
        },
        "ifVersion": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,18}$",
          "description": "Exact positive int64 decimal; omit only where current CLI reads a version before writing."
        },
        "returnView": {
          "enum": [
            "summary",
            "full"
          ],
          "default": "summary"
        }
      },
      "required": [
        "projectId",
        "taskId",
        "title"
      ],
      "additionalProperties": false,
      "not": {
        "required": [
          "before",
          "after"
        ]
      }
    },
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": false,
      "openWorldHint": false
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "data": {
          "type": "object",
          "properties": {
            "items": {
              "type": "array",
              "items": {
                "type": "object"
              }
            },
            "step": {
              "type": "object"
            },
            "nextCursor": {
              "type": [
                "string",
                "null"
              ]
            },
            "version": {
              "type": "string",
              "pattern": "^[1-9][0-9]{0,18}$"
            },
            "steps": {
              "type": "array",
              "items": {
                "type": "object"
              }
            }
          }
        },
        "meta": {
          "type": "object",
          "properties": {
            "requestId": {
              "type": "string"
            },
            "outcome": {
              "type": "string"
            }
          },
          "required": [
            "requestId"
          ]
        },
        "error": {
          "type": "object",
          "properties": {
            "code": {
              "type": "string"
            },
            "message": {
              "type": "string"
            },
            "requestId": {
              "type": "string"
            },
            "writeOutcome": {
              "enum": [
                "confirmed",
                "not_committed",
                "unknown"
              ]
            },
            "phase": {
              "type": "string"
            },
            "refs": {
              "type": "object"
            }
          },
          "required": [
            "code",
            "message",
            "requestId"
          ]
        }
      },
      "oneOf": [
        {
          "required": [
            "data",
            "meta"
          ],
          "not": {
            "required": [
              "error"
            ]
          }
        },
        {
          "required": [
            "error"
          ],
          "not": {
            "required": [
              "data"
            ]
          }
        }
      ]
    }
  },
