  {
    "name": "bot_delete",
    "description": "Request Bot deletion with an explicit version. Cleanup may remain pending. requestId is deletionId.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "botId": {
          "type": "string",
          "format": "uuid"
        },
        "ifVersion": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,18}$",
          "description": "Exact positive int64 decimal; omit only where current CLI reads a version before writing."
        },
        "requestId": {
          "type": "string",
          "format": "uuid"
        }
      },
      "required": [
        "botId",
        "ifVersion"
      ],
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": true,
      "openWorldHint": true
    },
    "outputSchema": {
