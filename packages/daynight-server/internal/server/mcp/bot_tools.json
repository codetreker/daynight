[
  {
    "name": "bot_list",
    "description": "Read a page of current Bot definitions.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "default": 50
        },
        "cursor": {
          "type": "string"
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "openWorldHint": false
    }
  },
  {
    "name": "bot_show",
    "description": "Read a Bot definition or its remaining deletion responsibility.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "botId": {
          "type": "string",
          "format": "uuid"
        }
      },
      "required": [
        "botId"
      ],
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "openWorldHint": false
    }
  },
  {
    "name": "bot_create",
    "description": "Persist a Bot definition. Pending startup is not readiness. requestId is the Bot ID.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "workerId": {
          "type": "string",
          "format": "uuid"
        },
        "cwd": {
          "type": "string"
        },
        "agent": {
          "type": "string",
          "enum": [
            "codex",
            "claude",
            "copilot"
          ]
        },
        "requestId": {
          "type": "string",
          "format": "uuid"
        },
        "model": {
          "type": "string",
          "minLength": 1,
          "description": "Explicit native model ID for this assistant; omit to use defaults."
        },
        "reasoningEffort": {
          "type": "string",
          "minLength": 1,
          "description": "Explicit native reasoning effort for the selected model; omit to use defaults."
        }
      },
      "required": [
        "name"
      ],
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": false,
      "openWorldHint": true
    }
  },
  {
    "name": "bot_delete",
    "description": "Request Bot deletion with an explicit version. Cleanup may remain pending. requestId is deletionId.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "botId": {
          "type": "string",
          "format": "uuid"
        },
        "ifVersion": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,18}$",
          "description": "Exact positive int64 decimal; omit only where current CLI reads a version before writing."
        },
        "requestId": {
          "type": "string",
          "format": "uuid"
        }
      },
      "required": [
        "botId",
        "ifVersion"
      ],
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": true,
      "openWorldHint": true
    }
  }
]
