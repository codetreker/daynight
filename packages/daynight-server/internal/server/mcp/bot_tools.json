[
  {
    "name": "bot_list",
    "description": "Read a page of current Bot definitions.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "default": 50
        },
        "cursor": {
          "type": "string"
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "openWorldHint": false
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "data": {
          "type": "object",
          "properties": {
            "items": {
              "type": "array",
              "items": {
                "type": "object"
              }
            },
            "nextCursor": {
              "type": [
                "string",
                "null"
              ]
            },
            "projection": {
              "enum": [
                "summary",
                "full"
              ]
            }
          },
          "required": [
            "items"
          ]
        },
        "meta": {
          "type": "object",
          "properties": {
            "requestId": {
              "type": "string"
            },
            "outcome": {
              "type": "string"
            }
          },
          "required": [
            "requestId"
          ]
        },
        "error": {
          "type": "object",
          "properties": {
            "code": {
              "type": "string"
            },
            "message": {
              "type": "string"
            },
            "requestId": {
              "type": "string"
            },
            "writeOutcome": {
              "enum": [
                "confirmed",
                "not_committed",
                "unknown"
              ]
            },
            "phase": {
              "type": "string"
            },
            "refs": {
              "type": "object"
            }
          },
          "required": [
            "code",
            "message",
            "requestId"
          ]
        }
      },
      "oneOf": [
        {
          "required": [
            "data",
            "meta"
          ],
          "not": {
            "required": [
              "error"
            ]
          }
        },
        {
          "required": [
            "error"
          ],
          "not": {
            "required": [
              "data"
            ]
          }
        }
      ]
    }
  },
  {
    "name": "bot_show",
    "description": "Read a Bot definition or its remaining deletion responsibility.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "botId": {
          "type": "string",
          "format": "uuid"
        }
      },
      "required": [
        "botId"
      ],
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "openWorldHint": false
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "data": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "format": "uuid"
            },
            "version": {
              "type": "string",
              "pattern": "^[1-9][0-9]{0,18}$"
            }
          }
        },
        "meta": {
          "type": "object",
          "properties": {
            "requestId": {
              "type": "string"
            },
            "outcome": {
              "type": "string"
            }
          },
          "required": [
            "requestId"
          ]
        },
        "error": {
          "type": "object",
          "properties": {
            "code": {
              "type": "string"
            },
            "message": {
              "type": "string"
            },
            "requestId": {
              "type": "string"
            },
            "writeOutcome": {
              "enum": [
                "confirmed",
                "not_committed",
                "unknown"
              ]
            },
            "phase": {
              "type": "string"
            },
            "refs": {
              "type": "object"
            }
          },
          "required": [
            "code",
            "message",
            "requestId"
          ]
        }
      },
      "oneOf": [
        {
          "required": [
            "data",
            "meta"
          ],
          "not": {
            "required": [
              "error"
            ]
          }
        },
        {
          "required": [
            "error"
          ],
          "not": {
            "required": [
              "data"
            ]
          }
        }
      ]
    }
  },
  {
    "name": "bot_create",
    "description": "Persist a Bot definition. Pending startup is not readiness. requestId is the Bot ID.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "workerId": {
          "type": "string",
          "format": "uuid"
        },
        "cwd": {
          "type": "string"
        },
        "agent": {
          "type": "string",
          "enum": [
            "codex",
            "claude",
            "copilot"
          ]
        },
        "requestId": {
          "type": "string",
          "format": "uuid"
        }
      },
      "required": [
        "name"
      ],
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": false,
      "destructiveHint": false,
      "openWorldHint": true
    },
    "outputSchema": {
      "type": "object",
      "properties": {
        "data": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "format": "uuid"
            },
            "version": {
              "type": "string",
              "pattern": "^[1-9][0-9]{0,18}$"
            }
          }
        },
        "meta": {
          "type": "object",
          "properties": {
            "requestId": {
              "type": "string"
            },
            "outcome": {
              "type": "string"
            }
          },
          "required": [
            "requestId"
          ]
        },
        "error": {
          "type": "object",
          "properties": {
            "code": {
              "type": "string"
            },
            "message": {
              "type": "string"
            },
            "requestId": {
              "type": "string"
            },
            "writeOutcome": {
              "enum": [
                "confirmed",
                "not_committed",
                "unknown"
              ]
            },
            "phase": {
              "type": "string"
            },
            "refs": {
              "type": "object"
            }
          },
          "required": [
            "code",
            "message",
            "requestId"
          ]
        }
      },
      "oneOf": [
        {
          "required": [
            "data",
            "meta"
          ],
          "not": {
            "required": [
              "error"
            ]
          }
        },
        {
          "required": [
            "error"
          ],
          "not": {
            "required": [
              "data"
            ]
          }
        }
      ]
    }
