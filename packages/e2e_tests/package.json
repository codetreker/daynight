{
  "name": "@codetreker/daynight-e2e",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "test:harness": "node --test --test-concurrency=3 test/*.test.ts tests/subtask-compat-gateway-check.ts tests/subtask-compat-process-check.ts tests/subtask-compat-interruption-check.ts tests/subtask-compat-artifact-check.ts tests/subtask-compat-worker-observer-check.ts",
    "test:auth-interruption": "node --test tests/subtask-compat-auth-browser-check.ts tests/subtask-compat-auth-browser-success-check.ts",
    "test": "node src/run.ts",
    "test:subtask-compat": "node src/subtask-compat.ts",
    "test:fallback-cache": "node src/subtask-compat-fallback-test.ts",
    "cleanup": "node src/ci-cleanup.ts",
    "test:recovery-registries": "node --test tests/subtask-compat-registry-real.ts"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "typescript": "7.0.2"
  }
}
