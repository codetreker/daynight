{
  "name": "@codetreker/daynight",
  "version": "0.60.1",
  "description": "A client command toolkit for development workflows",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/codetreker/daynight.git",
    "directory": "packages/daynight"
  },
  "type": "module",
  "bin": {
    "daynight": "dist/main.js",
    "dn": "dist/main.js"
  },
  "files": [
    "dist",
    "config.example.yml"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/clean-dist.ts && tsc -p tsconfig.build.json && node scripts/copy-resources.ts",
    "typecheck": "tsc --noEmit",
    "test": "pnpm run build && vitest run",
    "test:apfs": "DAYNIGHT_TEST_APFS=1 vitest run test/commands/review/apfs.test.ts",
    "acceptance": "pnpm run build && vitest run --config vitest.acceptance.config.ts",
    "completion:acceptance": "pnpm run build && node --require ./scripts/test-isolation.cts scripts/test-completion.ts",
    "test:stress": "pnpm run build && vitest run --config vitest.stress.config.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.247",
    "@discoveryjs/json-ext": "1.1.0",
    "@github/copilot": "1.0.105",
    "@github/copilot-sdk": "1.0.11",
    "@inquirer/prompts": "8.7.4",
    "better-sqlite3": "13.1.1",
    "cross-spawn": "7.0.6",
    "koffi": "3.3.4",
    "mime": "4.1.1",
    "read-cmd-shim": "6.0.0",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "semver": "7.8.5",
    "sharp": "0.35.5",
    "smol-toml": "1.9.1",
    "unified": "11.0.5",
    "which": "6.0.1",
    "ws": "8.22.0",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/cross-spawn": "6.0.6",
    "@types/node": "24.19.2",
    "@types/semver": "7.8.0",
    "@types/which": "3.0.4",
    "@types/ws": "8.18.2",
    "node-pty": "1.1.0",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
