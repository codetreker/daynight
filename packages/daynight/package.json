{
  "name": "@codetreker/daynight",
  "version": "0.21.7",
  "description": "A client command toolkit for development workflows",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/codetreker/daynight.git",
    "directory": "packages/daynight"
  },
  "type": "module",
  "bin": {
    "daynight": "dist/main.js",
    "dn": "dist/main.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "build": "node scripts/clean-dist.ts && tsc -p tsconfig.build.json && node scripts/copy-skills.ts",
    "typecheck": "tsc --noEmit",
    "test": "pnpm run build && vitest run",
    "test:apfs": "DAYNIGHT_TEST_APFS=1 vitest run test/commands/review/apfs.test.ts",
    "acceptance": "pnpm run build && vitest run --config vitest.acceptance.config.ts",
    "completion:acceptance": "pnpm run build && python3 -u test/acceptance/shell-completion.py"
  },
  "dependencies": {
    "@inquirer/prompts": "8.7.4",
    "better-sqlite3": "13.0.3",
    "cross-spawn": "7.0.6",
    "mime": "4.1.1",
    "read-cmd-shim": "6.0.0",
    "semver": "7.8.5",
    "which": "6.0.1",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/cross-spawn": "6.0.6",
    "@types/node": "24.19.2",
    "@types/semver": "7.8.0",
    "@types/which": "3.0.4",
    "node-pty": "1.1.0",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
