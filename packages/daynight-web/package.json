{
  "name": "@codetreker/daynight-web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "build": "pnpm typecheck && vite build",
    "test": "pnpm test:harness && pnpm test:coverage",
    "test:harness": "node --test scripts/ci.test.mts scripts/acceptance/auth-combined.test.mts scripts/acceptance/authentication.test.mts scripts/coverage.test.mts scripts/dagre.test.mts scripts/publish-assets.test.mts scripts/acceptance/report.test.mts scripts/acceptance/performance.test.mts scripts/acceptance/identity.test.mts scripts/acceptance/process-platform.test.mts scripts/acceptance/browser.test.mts scripts/acceptance/storage.test.mts scripts/acceptance/permission.test.mts scripts/acceptance/pipeline.test.mts scripts/acceptance/process.test.mts scripts/acceptance/installed-cli.test.mts scripts/acceptance/runner.test.mts",
    "test:coverage": "vitest run --coverage && node scripts/coverage.mts",
    "test:unit": "vitest run",
    "preview": "vite preview --host 127.0.0.1",
    "test:acceptance:apfs": "node scripts/acceptance.mts --apfs",
    "test:acceptance": "node scripts/acceptance.mts",
    "test:storage-native": "DAYNIGHT_TEST_APFS=1 node --test scripts/acceptance/storage-native.test.mts"
  },
  "dependencies": {
    "@dagrejs/dagre": "3.1.1",
    "@xyflow/react": "12.12.0",
    "idb": "8.0.4",
    "mermaid": "12.2.0",
    "mime": "4.1.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "tabbable": "6.5.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "5.0.5",
    "fake-indexeddb": "6.2.6",
    "jsdom": "29.1.1",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
