#!/usr/bin/env bash
set -euo pipefail
[[ -n ${FAKE_DOCKER_STATE:-} && -d $FAKE_DOCKER_STATE ]] || exit 99
printf '%s\n' "$*" >> "$FAKE_DOCKER_STATE/calls"
container_id=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
image_id=sha256:bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb
network_id=cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc
scenario=${FAKE_DOCKER_SCENARIO:-passed}
command=$1
shift
if [[ $command == compose ]]; then
  project=''
  directory=''
  file=''
  env_file=''
  while [[ $# -gt 0 ]]; do
    case $1 in
      --project-name) project=$2; shift 2 ;;
      --project-directory) directory=$2; shift 2 ;;
      --file) file=$2; shift 2 ;;
      --env-file) env_file=$2; shift 2 ;;
      *) break ;;
    esac
  done
  [[ $project =~ ^daynight-dev-ci-[0-9]{14}-[0-9]+-[0-9]{5}$ ]] || exit 98
  [[ $directory == */deployment/dev-ci && $file == "$directory/compose.yaml" && $env_file == */.tmp/dev-ci-private/*/auth.env && -f $env_file ]] || exit 97
  node -e 'if ((require("node:fs").statSync(process.argv[1]).mode & 0o777) !== 0o600) process.exit(97)' "$env_file"
  printf '%s\n' "$project" > "$FAKE_DOCKER_STATE/project"
  operation=$1
  shift
  case $operation in
    build)
      [[ $* == server ]] || exit 96
      [[ $scenario != build-failure ]] || exit 30
      touch "$FAKE_DOCKER_STATE/image"
      ;;
    up)
      touch "$FAKE_DOCKER_STATE/resources"
      [[ $scenario != partial-startup ]] || exit 31
      case $* in
        '--no-build --detach postgres gateway')
          if [[ $scenario == cancelled-bootstrap ]]; then
            printf ready > "$FAKE_DOCKER_STATE/child-ready"
            sleep 60
          fi
          if [[ $scenario == reconfigure ]]; then
            count=0
            [[ ! -f $FAKE_DOCKER_STATE/bootstrap-count ]] || count="$(< "$FAKE_DOCKER_STATE/bootstrap-count")"
            printf '%s\n' "$((count + 1))" > "$FAKE_DOCKER_STATE/bootstrap-count"
          fi
          if [[ $scenario == port-conflict && ! -f $FAKE_DOCKER_STATE/conflicted ]]; then
            touch "$FAKE_DOCKER_STATE/conflicted"
            printf '%s\n' 'fixture bind: address already in use' >&2
            exit 33
          fi
          ;;
        '--no-build --detach --force-recreate uniauth')
          node - "$env_file" "$scenario" <<'JS'
const fs = require('node:fs');
const path = require('node:path');
const state = JSON.parse(fs.readFileSync(path.join(path.dirname(process.argv[2]), 'auth-state.json'), 'utf8'));
if (!state.callbackURL || state.callbackURL !== `${state.publicOrigin}/auth/callback`) process.exit(88);
const ready = { origin: `http://127.0.0.1:${state.port}`, appId: 'private-fixture-app', appSecret: 'private-fixture-secret' };
if (process.argv[3] === 'fixture-invalid') delete ready.appId;
fs.writeFileSync(path.join(state.directory, 'ready.json'), JSON.stringify(ready), { mode: 0o600 });
JS
          ;;
        '--no-build --detach --wait --wait-timeout 120 server')
          [[ $(< "$env_file") == *"DAYNIGHT_UNIAUTH_APP_ID='private-fixture-app'"* && $(< "$env_file") == *"DAYNIGHT_UNIAUTH_APP_SECRET='private-fixture-secret'"* ]] || exit 87
          ;;
        *) exit 95 ;;
      esac
      ;;
    stop) [[ $* == '--timeout 10 server uniauth' ]] || exit 86 ;;
    rm) [[ $* == '--stop --force gateway' ]] || exit 85 ;;
    ps)
      if [[ ${1:-} == --quiet ]]; then printf '%s\n' "$container_id"; fi
      ;;
    port)
      if [[ $scenario == reconfigure ]]; then
        printf '127.0.0.1:%s\n' "$((32776 + $(< "$FAKE_DOCKER_STATE/bootstrap-count")))"
      else printf '%s\n' '127.0.0.1:32777'; fi
      ;;
    logs) printf '%s\n' 'owned fixture diagnostic' ;;
    down)
      [[ $* == '--volumes --remove-orphans --timeout 20' ]] || exit 94
      [[ $scenario != cleanup-failure* ]] || exit 32
      rm -f "$FAKE_DOCKER_STATE/resources"
      if [[ $scenario == attachment-volume-left ]]; then touch "$FAKE_DOCKER_STATE/attachment-volume"; fi
      if [[ $scenario == log-volume-left ]]; then touch "$FAKE_DOCKER_STATE/log-volume"; fi
      ;;
    *) exit 93 ;;
  esac
elif [[ $command == info ]]; then
  [[ $* == '--format {{.Architecture}}' ]] || exit 84
  if [[ $scenario == builder-platform ]]; then printf '%s\n' aarch64; else printf '%s\n' x86_64; fi
elif [[ $command == image ]]; then
  operation=$1
  shift
  case $operation in
    inspect)
      if [[ $* == *'{{.Architecture}}'* ]]; then
        if [[ $scenario == fixture-architecture ]]; then printf '%s\n' 'arm64'; else printf '%s\n' 'amd64'; fi
      else printf '%s\n' "$image_id"; fi
      ;;
    ls) if [[ -f $FAKE_DOCKER_STATE/image ]]; then printf '%s\n' "$image_id"; fi ;;
    rm)
      [[ $1 =~ ^daynight-dev-ci:[0-9]{14}-[0-9]+-[0-9]{5}$ ]] || exit 92
      rm -f "$FAKE_DOCKER_STATE/image"
      ;;
    *) exit 91 ;;
  esac
elif [[ $command == inspect ]]; then
  if [[ $scenario == image-mismatch ]]; then printf '%s\n' 'sha256:wrong'; else printf '%s\n' "$image_id"; fi
elif [[ $command == ps || $command == volume || $command == network ]]; then
  [[ $* == *label=com.docker.compose.project=daynight-dev-ci-* ]] || exit 90
  if [[ -f $FAKE_DOCKER_STATE/resources ]]; then
    project="$(< "$FAKE_DOCKER_STATE/project")"
    case $command in
      ps) printf '%s\n' "$container_id" ;;
      volume) printf '%s\n' "${project}_postgres-data" "${project}_attachment-data" "${project}_server-logs" ;;
      network) printf '%s\n' "$network_id" ;;
    esac
  fi
  if [[ $command == volume && -f $FAKE_DOCKER_STATE/attachment-volume ]]; then
    project="$(< "$FAKE_DOCKER_STATE/project")"
    printf '%s\n' "${project}_attachment-data"
  fi
  if [[ $command == volume && -f $FAKE_DOCKER_STATE/log-volume ]]; then
    project="$(< "$FAKE_DOCKER_STATE/project")"
    printf '%s\n' "${project}_server-logs"
  fi
else
  exit 89
fi
