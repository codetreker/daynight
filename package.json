{
  "name": "day-night-workspace",
  "private": true,
  "packageManager": "pnpm@11.28.6",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm --filter @codetreker/daynight build",
    "typecheck": "pnpm --filter @codetreker/daynight typecheck",
    "test": "pnpm dev:test && pnpm --filter @codetreker/daynight test",
    "test:apfs": "pnpm --filter @codetreker/daynight test:apfs",
    "acceptance": "pnpm --filter @codetreker/daynight acceptance",
    "check": "pnpm typecheck && pnpm test",
    "daynight": "pnpm --filter @codetreker/daynight exec node dist/main.js",
    "version:check": "node packages/daynight/scripts/check-version.ts",
    "web:dev": "pnpm --filter @codetreker/daynight-web dev",
    "web:typecheck": "pnpm --filter @codetreker/daynight-web typecheck",
    "web:test:storage-native": "pnpm --filter @codetreker/daynight-web test:storage-native",
    "web:test": "pnpm --filter @codetreker/daynight-web test",
    "web:build": "pnpm --filter @codetreker/daynight-web build && pnpm --filter @codetreker/daynight-web exec node scripts/publish-assets.mts",
    "completion:acceptance": "pnpm --filter @codetreker/daynight completion:acceptance",
    "web:acceptance:apfs": "pnpm --filter @codetreker/daynight-web test:acceptance:apfs",
    "web:acceptance": "pnpm --filter @codetreker/daynight-web test:acceptance",
    "dev:install": "node scripts/dev-install.mjs",
    "dev:test": "node --test scripts/dev-install.test.mjs"
  }
}
